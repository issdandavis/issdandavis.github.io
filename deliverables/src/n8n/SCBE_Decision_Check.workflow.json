    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\nconst decision = String(body.decision || '').trim().toUpperCase();\nconst rationale = String(body.rationale || '').trim();\nconst allowed = ['ALLOW', 'QUARANTINE', 'DENY'];\nconst ok = allowed.includes(decision) && rationale.length > 0;\nreturn [{ json: { ok, decision, rationale, workflow: body.workflow || '', owner: body.owner || '' } }];"
      },
      "id": "CheckRecord",
      "name": "Check Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-260, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok-is-true",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
